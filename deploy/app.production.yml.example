## PRODUCTION (app.forwardtrust.org.uk): Discourse v2026.9.0 (stock) + discourse-forward-trust + Lexicon.
## Tested on a copy of production on 22 Oct 2026 (docs/upgrade/13-production-rehearsal.md).
## Lines marked __COPY__ are filled on the server from containers/app.yml.old-fork
## (docs/upgrade/14-production-switch.md, step 5): no secret is ever written here.
## __LEXICON_MERGE_COMMIT__ is the merge commit of discourse-lexicon-plugin PR #1.
templates:
  - templates/postgres.18.template.yml
  - templates/redis.template.yml
  - templates/web.template.yml
  - templates/web.ratelimited.template.yml
  - templates/web.ssl.template.yml
  - templates/web.letsencrypt.ssl.template.yml

expose:
  - "80:80"   # http
  - "443:443" # https

params:
  db_default_text_search_config: "pg_catalog.english"
  db_shared_buffers: "256MB"
  upload_size: 100m
  ## Stock Discourse, pinned to the release the hops and the rehearsal tested (no more yalla-coop/discourse fork).
  version: v2026.9.0
  ## nginx rate limits for web.ratelimited.template.yml. Production had these as a local
  ## edit of the launcher's template (12/12/200/100 raised); here they survive launcher updates.
  reqs_per_second: 60
  burst_per_second: 60
  reqs_per_minute: 600
  burst_per_minute: 600
  conn_per_ip: 20

env:
  LC_ALL: en_US.UTF-8
  LANG: en_US.UTF-8
  LANGUAGE: en_US.UTF-8
  UNICORN_WORKERS: 4

  DISCOURSE_HOSTNAME: app.forwardtrust.org.uk
  DISCOURSE_DEVELOPER_EMAILS: __COPY__

  DISCOURSE_SMTP_ADDRESS: __COPY__
  DISCOURSE_SMTP_PORT: __COPY__
  DISCOURSE_SMTP_USER_NAME: __COPY__
  DISCOURSE_SMTP_PASSWORD: __COPY__
  DISCOURSE_SMTP_DOMAIN: __COPY__
  DISCOURSE_NOTIFICATION_EMAIL: __COPY__

  LETSENCRYPT_ACCOUNT_EMAIL: __COPY__

  ## Forward Trust rate limits (were inside the old fork's code; stock Discourse needs them here).
  ## Same values as deploy/forward-trust.env.
  DISCOURSE_MAX_USER_API_REQS_PER_MINUTE: 1000000
  DISCOURSE_MAX_USER_API_REQS_PER_DAY: 100000000
  DISCOURSE_MAX_ADMIN_API_REQS_PER_MINUTE: 1000000
  DISCOURSE_MAX_REQS_PER_IP_PER_MINUTE: 1000000
  DISCOURSE_MAX_REQS_PER_IP_PER_10_SECONDS: 1000000
  DISCOURSE_MAX_ASSET_REQS_PER_IP_PER_10_SECONDS: 1000000
  DISCOURSE_MAX_REQS_PER_IP_MODE: warn
  DISCOURSE_SKIP_PER_IP_RATE_LIMIT_TRUST_LEVEL: 0

  ## SKIP_POST_DEPLOYMENT_MIGRATIONS is not set on purpose: after a jump of nearly
  ## two years the clean-up migrations must run.

volumes:
  - volume:
      host: /var/discourse/shared/standalone
      guest: /shared
  - volume:
      host: /var/discourse/shared/standalone/log/var-log
      guest: /var/log

hooks:
  after_code:
    - exec:
        cd: $home/plugins
        cmd:
          ## Our customisations as a plugin, pinned to the tested commit.
          - git clone https://github.com/yalla-coop/discourse-forward-trust.git
          - git -C discourse-forward-trust checkout 264cbd27fecfcb20cac39c368505d703a523ccd4
          ## Lexicon pinned (production used to clone master unpinned).
          - git clone https://github.com/yalla-coop/discourse-lexicon-plugin.git
          - git -C discourse-lexicon-plugin checkout __LEXICON_MERGE_COMMIT__
          - git clone https://github.com/discourse/docker_manager.git
          ## discourse-reactions and discourse-data-explorer are part of Discourse
          ## since 3.5.4: no separate clone (it would clash with the bundled copy).

run:
  - exec: echo "Beginning of custom commands"
  - exec: echo "End of custom commands"
