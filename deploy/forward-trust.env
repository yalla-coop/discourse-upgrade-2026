# Forward Trust settings that production needs on top of stock Discourse.
# Used by script/safety-net.sh (docker exec --env-file) and copied into the
# `env:` section of production's containers/app.yml (see docs/upgrade/04-plugin.md).
DISCOURSE_MAX_USER_API_REQS_PER_MINUTE=1000000
DISCOURSE_MAX_USER_API_REQS_PER_DAY=100000000
DISCOURSE_MAX_ADMIN_API_REQS_PER_MINUTE=1000000
DISCOURSE_MAX_REQS_PER_IP_PER_MINUTE=1000000
DISCOURSE_MAX_REQS_PER_IP_PER_10_SECONDS=1000000
DISCOURSE_MAX_ASSET_REQS_PER_IP_PER_10_SECONDS=1000000
DISCOURSE_MAX_REQS_PER_IP_MODE=warn
DISCOURSE_SKIP_PER_IP_RATE_LIMIT_TRUST_LEVEL=0
